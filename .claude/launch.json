{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "frontend"
      ],
      "port": 4173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "csp-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/scripts/serve-with-headers.mjs"
      ],
      "port": 8788
    }
  ]
}